# Leave the API key empty to run the local rules engine.
LISTING_LLM_API_KEY=
LISTING_LLM_BASE_URL=https://api.openai.com/v1
LISTING_LLM_MODEL=gpt-4.1-mini-2025-04-14

# For a separately installed local Ollama, uncomment both lines and restart.
# LISTING_LLM_PROVIDER=ollama
# LISTING_OLLAMA_MODEL=qwen2.5:7b

# Optional authorized Nexscope Product Detail API access.
# LISTING_NEXSCOPE_API_KEY=

# Optional local settings.
# LISTING_DB=data/workbench.sqlite3
# LISTING_SEED_DEMO=1
# LISTING_RULES_FILE=backend/rules.json
# LISTING_EDITOR_OCR=tesseract
# Optional Tesseract languages installed on this computer, e.g. eng+deu.
# LISTING_OCR_LANG=eng
# Enable only for permitted browser collection. Install Playwright and Chromium first.
# LISTING_AMAZON_PLAYWRIGHT=1
